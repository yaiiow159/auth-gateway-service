<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.example.auth</groupId>
    <artifactId>auth-gateway-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>auth-center</artifactId>
  <name>auth-center</name>
  <description>授權中心：身分認證、RBAC 權限管理、Token 簽發與撤銷、JWKS 公鑰發布</description>

  <dependencies>
    <dependency>
      <groupId>com.example.auth</groupId>
      <artifactId>auth-contract</artifactId>
    </dependency>

    <!--
      管理端點與其他微服務一樣位於網關之後，因此同樣消費網關注入的身分。
      授權中心在這件事上沒有特權：它的 /admin/** 也要通過 @RequiresPermission 檢查。
    -->
    <dependency>
      <groupId>com.example.auth</groupId>
      <artifactId>auth-client-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      分散式追蹤：Micrometer Tracing 提供與供應商無關的 API，OTLP exporter 負責輸出。
      選 OTLP 而非任何一家 APM 的專屬協定，是為了讓後端（Jaeger、Tempo、Datadog…）
      成為可替換的部署決定，而不是寫死在程式碼裡的依賴。
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!--
      只引入 spring-security-crypto（BCrypt），不引入 spring-boot-starter-security：
      Auth Center 的 HTTP 入口本身不需要 Spring Security 的 Filter Chain，
      引入完整 starter 只會帶來一條需要被「關掉」的預設安全鏈，徒增認知負擔。
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>

    <!-- 資料表結構由版本化遷移腳本管理，讓每個環境的結構演進可追溯、可重現 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- H2 支援仍內建於 flyway-core；PostgreSQL 在 Flyway 10 已拆成獨立模組，
         正式環境改用它時只需切換 DB_URL，遷移腳本本身維持可攜 -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
